<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Header Card with Gradient (Fixed at top) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/bg_header_green">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Báo Cáo Hoạt Động"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Phân tích tình hình kho kim loại"
                android:textColor="#D4D0FF"
                android:textSize="14sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Grid Metrics 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Row 1: Products and Categories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Card 1: Total Products -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center">

                            <FrameLayout
                                  android:layout_width="44dp"
                                  android:layout_height="44dp"
                                  android:background="@drawable/bg_icon_circle_green"
                                  android:layout_marginBottom="10dp">

                                <ImageView
                                      android:layout_width="22dp"
                                      android:layout_height="22dp"
                                      android:src="@android:drawable/ic_menu_agenda"
                                      app:tint="@color/colorSuccess"
                                      android:layout_gravity="center" />
                            </FrameLayout>

                            <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="Tổng Sản Phẩm"
                                  android:textColor="@color/colorTextGrey"
                                  android:textSize="12sp"
                                  android:fontFamily="sans-serif" />

                            <TextView
                                  android:id="@+id/tvTotalProducts"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_marginTop="6dp"
                                  android:text="--"
                                  android:textColor="@color/colorSuccess"
                                  android:textSize="24sp"
                                  android:textStyle="bold"
                                  android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: Total Categories -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center">

                            <FrameLayout
                                  android:layout_width="44dp"
                                  android:layout_height="44dp"
                                  android:background="@drawable/bg_icon_circle_blue"
                                  android:layout_marginBottom="10dp">

                                <ImageView
                                      android:layout_width="22dp"
                                      android:layout_height="22dp"
                                      android:src="@android:drawable/ic_menu_view"
                                      app:tint="@color/colorInfo"
                                      android:layout_gravity="center" />
                            </FrameLayout>

                            <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="Tổng Danh Mục"
                                  android:textColor="@color/colorTextGrey"
                                  android:textSize="12sp"
                                  android:fontFamily="sans-serif" />

                            <TextView
                                  android:id="@+id/tvTotalCategories"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_marginTop="6dp"
                                  android:text="--"
                                  android:textColor="@color/colorInfo"
                                  android:textSize="24sp"
                                  android:textStyle="bold"
                                  android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2: Total Stock Qty and Total Value -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <!-- Card 3: Total Stock Quantity -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center">

                            <FrameLayout
                                  android:layout_width="44dp"
                                  android:layout_height="44dp"
                                  android:background="@drawable/bg_icon_circle_orange"
                                  android:layout_marginBottom="10dp">

                                <ImageView
                                      android:layout_width="22dp"
                                      android:layout_height="22dp"
                                      android:src="@android:drawable/ic_input_add"
                                      app:tint="@color/colorWarning"
                                      android:layout_gravity="center" />
                            </FrameLayout>

                            <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="Tổng Tồn Kho (Cái)"
                                  android:textColor="@color/colorTextGrey"
                                  android:textSize="12sp"
                                  android:fontFamily="sans-serif" />

                            <TextView
                                  android:id="@+id/tvTotalStockQty"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_marginTop="6dp"
                                  android:text="--"
                                  android:textColor="@color/colorWarning"
                                  android:textSize="24sp"
                                  android:textStyle="bold"
                                  android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: Total Value -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center">

                            <FrameLayout
                                  android:layout_width="44dp"
                                  android:layout_height="44dp"
                                  android:background="@drawable/bg_icon_circle_purple"
                                  android:layout_marginBottom="10dp">

                                <ImageView
                                      android:layout_width="22dp"
                                      android:layout_height="22dp"
                                      android:src="@android:drawable/ic_menu_compass"
                                      app:tint="@color/colorPrimary"
                                      android:layout_gravity="center" />
                            </FrameLayout>

                            <TextView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:text="Tổng Giá Trị Kho"
                                  android:textColor="@color/colorTextGrey"
                                  android:textSize="12sp"
                                  android:fontFamily="sans-serif" />

                            <TextView
                                  android:id="@+id/tvTotalStockValue"
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:layout_marginTop="6dp"
                                  android:text="--"
                                  android:textColor="@color/colorPrimary"
                                  android:textSize="20sp"
                                  android:textStyle="bold"
                                  android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 1: Low Stock Alert Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="@color/colorDanger"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cảnh báo tồn kho thấp (≤ 5)"
                            android:textColor="@color/colorTextDark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llLowStockContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLowStockEmptyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tất cả sản phẩm đều có tồn kho an toàn."
                            android:textColor="@color/colorTextGrey"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Category Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/colorInfo"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cơ cấu tồn kho theo Danh mục"
                            android:textColor="@color/colorTextDark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llCategoryBreakdownContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCategoryBreakdownEmptyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đang tính toán cơ cấu kho..."
                            android:textColor="@color/colorTextGrey"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Top 3 High-Value Stock -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top 3 sản phẩm giá trị tồn kho lớn"
                            android:textColor="@color/colorTextDark"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llTopValueProductsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTopValueEmptyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chưa có dữ liệu tính toán."
                            android:textColor="@color/colorTextGrey"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Card: System Notifications -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSystemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                          android:layout_width="44dp"
                          android:layout_height="44dp"
                          android:background="@drawable/bg_icon_circle_purple"
                          android:layout_marginEnd="16dp">

                        <ImageView
                              android:layout_width="22dp"
                              android:layout_height="22dp"
                              android:src="@android:drawable/ic_dialog_info"
                              app:tint="@color/colorPrimary"
                              android:layout_gravity="center" />
                    </FrameLayout>

                    <LinearLayout
                          android:layout_width="0dp"
                          android:layout_height="wrap_content"
                          android:layout_weight="1"
                          android:orientation="vertical">

                        <TextView
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Thông báo hệ thống"
                              android:textColor="@color/colorTextDark"
                              android:textStyle="bold"
                              android:textSize="15sp"
                              android:layout_marginBottom="6dp"
                              android:fontFamily="sans-serif-medium" />

                        <TextView
                              android:id="@+id/tvSystemStatusText"
                              android:layout_width="wrap_content"
                              android:layout_height="wrap_content"
                              android:text="Hệ thống cơ sở dữ liệu đám mây Firebase đang hoạt động ổn định. Mọi thông tin thay đổi giá và cập nhật hình ảnh sản phẩm đều được ghi nhận theo thời gian thực."
                              android:textColor="@color/colorTextGrey"
                              android:textSize="13sp"
                              android:lineSpacingMultiplier="1.3"
                              android:fontFamily="sans-serif" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
