<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="0dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Close Button -->
            <ImageView
                android:id="@+id/btnCloseQr"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/colorTextGrey"
                android:contentDescription="Đóng"
                android:clickable="true"
                android:focusable="true" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã QR Sản Phẩm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <!-- Product Name -->
            <TextView
                android:id="@+id/tvQrProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextDark"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="2dp" />

            <!-- Product Code -->
            <TextView
                android:id="@+id/tvQrProductCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/colorTextGrey"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="16dp" />

            <!-- QR Code Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/divider"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:background="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Save Button -->
                <android.widget.Button
                    android:id="@+id/btnSaveQr"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="💾 Lưu ảnh"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="6dp" />

                <!-- Share Button -->
                <android.widget.Button
                    android:id="@+id/btnShareQr"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="📤 Chia sẻ"
                    android:textColor="@color/colorPrimary"
                    android:background="@drawable/btn_cancel"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
