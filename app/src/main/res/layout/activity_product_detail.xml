<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        app:title="Chi Tiết Sản Phẩm"
        app:titleCentered="true"
        app:titleTextColor="@color/colorOnSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/colorOnSurface"
        app:elevation="0dp"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:isScrollContainer="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="160dp"
            android:clipToPadding="false"
            android:gravity="center_horizontal">

        <!-- Main Details Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Expanded Product Image Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardImageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">

                        <ImageView
                            android:id="@+id/imgPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:background="@color/colorSurfaceVariant" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Float camera action -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnPickImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="-8dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:fabCustomSize="44dp"
                        app:elevation="6dp"
                        app:tint="@android:color/white"
                        app:backgroundTint="@color/colorPrimary"
                        android:contentDescription="Đổi ảnh" />
                </FrameLayout>

                <!-- Upload status label -->
                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:text="Nhấn camera để chọn ảnh"
                    android:fontFamily="sans-serif" />

                <!-- Product Code Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã sản phẩm"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etProductCode"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:hint="Nhập hoặc quét mã sản phẩm"
                            android:inputType="text"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/edit_text_background"
                            android:textColor="@color/colorTextDark"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif" />

                        <ImageButton
                            android:id="@+id/btnScanCode"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_edit_circle"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/colorPrimary"
                            android:contentDescription="Quét mã vạch" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Product Name Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên sản phẩm *"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium" />

                    <EditText
                        android:id="@+id/etProductName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Nhập tên sản phẩm"
                        android:inputType="text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/edit_text_background"
                        android:textColor="@color/colorTextDark"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Category Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Danh mục sản phẩm"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium" />

                    <Spinner
                        android:id="@+id/spCategory"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>

                <!-- Pricing Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Import Price -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá nhập"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <EditText
                            android:id="@+id/etImportPrice"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="0"
                            android:inputType="number"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/edit_text_background"
                            android:textColor="@color/colorTextDark"
                            android:textColorHint="@color/text_hint"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Sell Price -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá bán"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <EditText
                            android:id="@+id/etSellPrice"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="0"
                            android:inputType="number"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/edit_text_background"
                            android:textColor="@color/colorPriceOrange"
                            android:textColorHint="@color/text_hint"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Last Import Info -->
                <TextView
                    android:id="@+id/tvLastImportInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Stock Quantity Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số lượng tồn kho"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium" />

                    <EditText
                        android:id="@+id/etStockQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="0"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/edit_text_background"
                        android:textColor="@color/colorTextDark"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Note Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghi chú"
                        android:textColor="@color/colorTextDark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium" />

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:hint="Nhập ghi chú, công dụng..."
                        android:inputType="textMultiLine"
                        android:gravity="top|start"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/edit_text_background"
                        android:textColor="@color/colorTextDark"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Is Bundle Switch Form Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Là sản phẩm bán kèm (Bundle)"
                            android:textColor="@color/colorTextDark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đánh dấu nếu đây là phụ kiện bán kèm"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swIsBundle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Edit Button (visible in view mode only) -->
        <android.widget.Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✏️ Sửa Sản Phẩm"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Generate QR Code Button (visible in view mode only) -->
        <android.widget.Button
            android:id="@+id/btnGenerateQR"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📱 Tạo mã QR"
            android:textColor="@color/colorPrimary"
            android:background="@drawable/btn_outline_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Save Button (visible in edit mode only) -->
        <android.widget.Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Lưu Sản Phẩm"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <android.widget.Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Xem lịch sử thay đổi giá"
            android:textColor="@color/colorPrimary"
            android:background="@android:color/transparent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
