<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Section 1: Add new category -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="20dp">

        <EditText
            android:id="@+id/et_new_category"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.0"
            android:layout_marginEnd="12dp"
            android:hint="Nhập tên danh mục mới..."
            android:textColor="@color/colorTextDark"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:background="@drawable/edit_text_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textCapWords"
            android:fontFamily="sans-serif" />

        <Button
            android:id="@+id/btn_add_category"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="+ Thêm"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_btn_add"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

    <!-- Section 2: List title -->
    <TextView
        android:id="@+id/tv_list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách danh mục hiện có:"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/colorTextGrey"
        android:paddingBottom="12dp" />

    <!-- Section 3: List content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <LinearLayout
            android:id="@+id/ll_categories_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
