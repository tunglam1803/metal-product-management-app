<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Product Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/colorSurfaceVariant">

                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Ảnh mặt hàng" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Product Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <!-- SKU Code Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_price"
                    android:backgroundTint="@color/cardAccentBlue"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp">

                    <TextView
                        android:id="@+id/tvProductCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÃ: MK-9001"
                        android:textColor="@color/colorAccentBlue"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ốc lục giác chìm thép đen M8x30"
                    android:textColor="@color/colorTextDark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium" />

                <!-- Custom Price Highlight Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_price"
                    android:backgroundTint="@color/cardAccentOrange"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GIÁ BÁN CHO CTY:"
                            android:textColor="@color/colorPriceOrange"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvCustomPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150.000 đ"
                            android:textColor="@color/colorPriceOrange"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Standard list price reference -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá niêm yết: "
                            android:textColor="@color/colorTextGrey"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvStandardPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="170.000 đ"
                            android:textColor="@color/colorTextGrey"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvPriceDiffBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-20.000 đ"
                            android:textColor="@color/colorSuccess"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Note (if any) -->
                <TextView
                    android:id="@+id/tvProductNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ghi chú: Thường lấy thùng 100 cái, giá ưu đãi"
                    android:textColor="@color/colorTextGrey"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <!-- Last updated info -->
                <TextView
                    android:id="@+id/tvUpdatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cập nhật: 15/06/2026"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Actions (Edit & Delete) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnEditPrice"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_share_btn"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="Sửa giá riêng" />

                <ImageButton
                    android:id="@+id/btnDeleteProduct"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_share_btn"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/colorDanger"
                    android:contentDescription="Xóa khỏi danh sách" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
